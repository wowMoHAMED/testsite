{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "api/comm.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/comm", "dest": "/api/comm.js" },
    { "src": "/confirm", "dest": "/index.js" },
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}
