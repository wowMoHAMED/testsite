<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Admin - Mohamed's Restaurant</title>
  <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image" sizes="32x32" href="/uploads/Screenshot 2026-02-06 221810.png">
</head>
<body>
  <!-- Barre de navigation -->
  <header class="navbar">
    <div class="logo">👨‍🍳 Admin Dashboard</div>
    <nav class="nav-links" id="adminNav">
    <a href="/">Accueil</a>
    <a href="/meals/admin">Admin</a>
    <a href="/orders/commandes">Commandes</a>
    <a href="/auth/logout">Déconnexion</a>
    <button id="darkModeToggle">🌙 Mode Nuit</button>
  </nav>
    <div class="menu-toggle" id="menuToggle">
    ☰
  </div>
  </header>
<section class="admin">
  <!-- Formulaire d’ajout -->
  <section class="admin-form">
    <h2>Ajouter un nouveau plat</h2>
    <form action="/meals/add" method="POST" enctype="multipart/form-data">
    
      <input type="text" name="name" placeholder="Nom du plat" required>
      <input type="number" name="price" placeholder="Prix (MAD)" required>
      <input type="text" name="category" placeholder="Catégorie (Pizza, Dessert...)" required>
      <input type="text" name="description" placeholder="Description">
      <p>Choisir une image :</p> <input type="file" name="image" accept="image/*" onchange="previewImage(event)">
       <img id="imagePreview" style="max-width: 200px; display: none; margin-top: 10px;"> 
      <p>Vidéo :</p>
  <input type="file" name="video" accept="video/*">

      <button type="submit">➕ Ajouter</button>
    </form>
  </section>
  <!-- Liste des plats existants -->
  <section class="admin-list">
    <h2>Plats existants</h2>
    <ul>
      <% meals.forEach(meal => { %>
        <li>
          <strong><%= meal.name %></strong> — <%= meal.price %> MAD  
          (<%= meal.category %>)
          <form action="/meals/edit/<%= meal._id %>" 
      method="POST" 
      enctype="multipart/form-data">

  <input type="text" name="name" value="<%= meal.name %>">
  <input type="number" name="price" value="<%= meal.price %>">
  <input type="text" name="category" value="<%= meal.category %>">
  <input type="text" name="description" value="<%= meal.description %>">
  <p>Image actuelle :</p>
  <img src="<%= meal.image %>" style="max-width:100px;">
  <p>Changer l’image :</p>
  <input type="file" name="image" accept="image/*">
    <p>Vidéo actuelle :</p>
    <video src="<%= meal.video %>" controls style="max-width:200px;"></video>
  <p>Changer la vidéo :</p>
 
  <input  type="file" name="video" accept="video/*">

  <button type="submit">✏️ Modifier</button>
</form>

<script>
  function previewImage(event) {
    const file = event.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('imagePreview');
        preview.src = e.target.result;
        preview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }
  }
</script>      
    <!-- modifier image-->
           
          </form> 

          <!-- Formulaire de suppression -->
          <form action="/meals/delete/<%= meal._id %>" method="POST">
            <button type="submit" class="danger">🗑️ Supprimer</button>
            
          </form>
          
        </li>
      <% }) %>
    </ul>
  </section>
  </section>
  <script>
  const toggle = document.getElementById('darkModeToggle');
  toggle.addEventListener('click', () => {
    document.body.classList.toggle('night');
  });
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const menuToggle = document.getElementById("menuToggle");
    const adminNav = document.getElementById("adminNav");

    menuToggle.addEventListener("click", function () {
      adminNav.classList.toggle("active");
    });
  });
</script>

</body>
</html>
