<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Commandes Admin</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<h2>Toutes les commandes</h2>
<ul>
  <% orders.forEach(order => { %>
    <li>
      #<%= order.orderNumber %> - <%= order.firstName %> <%= order.lastName %> - Total: <%= order.total %> MAD - <%= order.createdAt.toLocaleString() %>
      <ul>
        <% order.cart.forEach(item => { %>
          <li><%= item.mealName %> x <%= item.quantity %> = <%= item.lineTotal %> MAD</li>
        <% }) %>
      </ul>
    </li>
  <% }) %>
</ul>
</body>
</html>
