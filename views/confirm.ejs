<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Commande réussie</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image" sizes="32x32" href="uploads\istockphoto-1057455004-612x612-removebg-preview.png">
</head>
<body>
      <header class="navbar">
              <div class="logo">Chiguer's phone</div>
     <nav class="nav-links" id="navLinks">
    <a href="/">Accueil</a>
    <button id="darkModeToggle">🌙 Mode Nuit</button>
 

<!----><script>
  const adminZone = document.getElementById('secretAdmin');

  adminZone.addEventListener('click', () => {
    window.location.href = '/admin-login';
  });
</script>
  </nav>
  <div class="menu-toggle" id="menuToggle">
    ☰
  </div>
    </header>
  
<section class="confirmation">
   <h2>✅ Votre commande est effectuée</h2>
 
  <ul>
    <% cart.forEach((item, idx) => { %>
      <li>
        <div class="imgvali">
          <img src="<%= item.image %>" alt="<%= item.mealName %>" class="cart-img">
          <h3>Nom : <%= item.mealName %></h3>
          <h3>Quantité : <%= item.quantity %></h3>
          <h3>Prix : <%= item.lineTotal %> MAD</h3>
        </div>
      </li>
    <% }) %>
  </ul>

  <div class="merci">
    <p>Merci <%= firstName %> <%= lastName %> !</p>
    <p>Numéro de commande : <strong><%= orderNumber %></strong></p>
    <p>Adresse : <%= address %></p>
    <p>Email : <%= email %></p>
    <p>Téléphone : <%= phone %></p>
    <p>Code postal : <%= postalCode %></p>
  </div>

  <div class="totla">
    <h2>Total : <%= total %> MAD</h2>
  </div>
  <h3>Attendez-vous le contact du livreur, Merci !</h3>

</section>
<script>
  const toggle = document.getElementById('darkModeToggle');
  const body = document.body;
  const header = document.querySelector('header.navbar');
  const checkout = document.querySelector('section.checkout');

  // Vérifier si le mode nuit est déjà activé
  if(localStorage.getItem('darkMode') === 'enabled') {
    enableDarkMode();
  }

  toggle.addEventListener('click', () => {
    if(body.classList.contains('dark-mode')) {
      disableDarkMode();
    } else {
      enableDarkMode();
    }
  });

  function enableDarkMode() {
    body.classList.add('dark-mode');
    header.classList.add('dark-mode');
    checkout.classList.add('dark-mode');
    localStorage.setItem('darkMode', 'enabled');
  }

  function disableDarkMode() {
    body.classList.remove('dark-mode');
    header.classList.remove('dark-mode');
    checkout.classList.remove('dark-mode');
    localStorage.setItem('darkMode', 'disabled');
  }
</script>
<script>
  // Sélection des éléments
const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

// État du menu : ouvert ou fermé
let menuOpen = false;

// Quand on clique sur le toggle
menuToggle.addEventListener("click", () => {
  menuOpen = !menuOpen; // on inverse l'état
  if (menuOpen) {
    navLinks.classList.add("active"); // ouvre le menu
  } else {
    navLinks.classList.remove("active"); // ferme le menu
  }
});

// Optionnel : si tu veux fermer le menu quand on clique sur un lien
const navItems = navLinks.querySelectorAll("a, button, .secret-admin");
navItems.forEach(item => {
  item.addEventListener("click", () => {
    navLinks.classList.remove("active");
    menuOpen = false;
  });
});

</script>
</body>
</html>
