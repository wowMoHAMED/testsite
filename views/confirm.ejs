<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Commande réussie</title>
  <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image" sizes="32x32" href="/uploads/Screenshot 2026-02-06 221810.png">
</head>
<body>
      <header class="navbar">
              <div class="logo">🍴 Chiguer Restaurant</div>
     <nav>

     <a href="/">Accueil</a>
     <button id="darkModeToggle">🌙 Mode Nuit</button>
    </nav>
    </header>
  
<section class="confirmation">
  <h2>✅ votre commande est effectué Merci!</h2>
  <h3>attendez vous le contact de livreur Merci!</h3>
  <form action="/orders/payment" method="POST">
 
<% cart.forEach((item, idx) => { %>
          <li>
           
            <div class="imgvali"><img src="<%= item.image %>" alt="<%= item.mealName %>" class="cart-img">
            <h3> nom:<%= item.mealName %> </h3>
            <h3> quantié :<%= item.quantity %>  </h3>
                 <h3>prix :<%= item.lineTotal %> MAD </h3>
                  </li>

        <% }) %>
 
</form>
  
</form>
        </div>
        <div class="merci">
        
  <p>Merci <%= firstName %> <%= lastName %> !</p>
  <p>Numéro de commande : <strong><%= orderNumber %></strong></p>
  <p>Adresse : <%= address %></p>
  <p>Email : <%= email %></p>
  <p>Téléphone : <%= phone %></p>
  <p>Code postal : <%= postalCode %></p>
  </div>
  <div class="totla"> <p>Total : <%= total %> MAD</p></div>
  

</section>


  

  




  
</body>
</html>
