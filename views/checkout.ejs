<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checkout</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<h2>Finaliser votre commande</h2>

<form action="/orders/checkout" method="POST">

  <% if(cart.length === 0) { %>
    <p>Votre panier est vide</p>
  <% } else { %>
    <% cart.forEach((item, idx) => { %>
      <div>
        <p><strong><%= item.mealName %></strong></p>
        <p>Quantité: <%= item.quantity %></p>
        <p>Prix: <%= item.lineTotal %> MAD</p>
        <input type="hidden" name="cartItems[<%= idx %>][mealName]" value="<%= item.mealName %>">
        <input type="hidden" name="cartItems[<%= idx %>][quantity]" value="<%= item.quantity %>">
        <input type="hidden" name="cartItems[<%= idx %>][lineTotal]" value="<%= item.lineTotal %>">
        <input type="hidden" name="cartItems[<%= idx %>][image]" value="<%= item.image %>">
      </div>
    <% }) %>

    <h3>Total: <%= cartTotal %> MAD</h3>

    <div>
      <input type="text" name="firstName" placeholder="Prénom" required>
      <input type="text" name="lastName" placeholder="Nom" required>
      <input type="text" name="address" placeholder="Adresse" required>
      <input type="email" name="email" placeholder="Email" required>
      <input type="tel" name="phone" placeholder="Téléphone" required>
      <input type="text" name="postalCode" placeholder="Code postal" required>
    </div>

    <input type="hidden" name="paymentType" value="cash">

    <button type="submit">💵 Paiement cash à la livraison</button>
  <% } %>

</form>
</body>
</html>
